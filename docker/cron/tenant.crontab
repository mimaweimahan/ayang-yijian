# 租户专属 Crontab（supercronic 格式，与标准 crontab 兼容）
# 时区由容器环境变量 TZ 控制
# 订单重置时间对齐现网宝塔任务：每天 12:01（见 deploy/cron/crontab.json）
#
# 字段: 分 时 日 月 周  命令

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 每分钟：订单/账变异常巡检（轻量）
*/1 * * * * cd /var/www/html && php think monitor >> /var/www/html/runtime/cron_monitor.log 2>&1

# 每天 01:30：生成昨日统计
30 1 * * * cd /var/www/html && php think createCensus >> /var/www/html/runtime/cron_census.log 2>&1

# 每天 12:01：用户订单重置 / 清算（对齐现网：deploy/cron 任务「qq qq」）
1 12 * * * cd /var/www/html && php cron_reset_orders.php >> /var/www/html/runtime/cron_reset_orders.log 2>&1

# 每天 03:00：自动增加信用分
0 3 * * * cd /var/www/html && php think userAddCredit >> /var/www/html/runtime/cron_credit.log 2>&1

# 每天 04:10：清理过期会话文件（可选，失败忽略）
10 4 * * * find /var/www/html/runtime/session -type f -mtime +7 -delete 2>/dev/null || true

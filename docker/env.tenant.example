# 渲染 docker-compose.template.yml 时使用的变量示例
# 复制为 tenants/<id>/.env.compose 或交给开通脚本填充

TENANT_ID=agent01
DB_NAME=db_agent01
PORT=18001

DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=db_agent01
DB_PASS=ChangeMeStrongPass
DB_PREFIX=mod_

APP_URL=https://agent01.yourdomain.com
TZ=Asia/Shanghai
IMAGE_TAG=tenant-app:php74
TENANT_CODE_DIR=/var/www/tenants/agent01
WORKER_SLEEP=30

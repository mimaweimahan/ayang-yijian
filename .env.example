; =============================================================================
; 租户克隆模板（ThinkPHP 6 INI 风格 .env）
; 用法：复制为 .env 后，用脚本将 {{VAR}} 替换为实际值。
; 占位符对照（自动化脚本可用同名变量）：
;   APP_URL / APP_HOST / FRONTEND_INVITE_BASE / APP_DEBUG / APP_TIMEZONE
;   DB_TYPE / DB_HOST / DB_NAME / DB_USER / DB_PASS / DB_PORT / DB_CHARSET / DB_PREFIX
;   CACHE_DRIVER / REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_SELECT
;   LANG_DEFAULT / SYSTEM_STOP / 及下方 [USER] 业务开关
; =============================================================================

APP_DEBUG = {{APP_DEBUG}}

[APP]
DEFAULT_TIMEZONE = {{APP_TIMEZONE}}
; 应用主机（可选，多数场景可留空，由 Nginx/请求域名决定）
HOST = {{APP_HOST}}
; 前端 H5 公网根（无尾斜杠），用于邀请链接 invite_url；不填则回退为当前 API 域名
; 例：https://h5.example.com
FRONTEND_INVITE_BASE = {{FRONTEND_INVITE_BASE}}

[DATABASE]
TYPE = {{DB_TYPE}}
HOSTNAME = {{DB_HOST}}
DATABASE = {{DB_NAME}}
USERNAME = {{DB_USER}}
PASSWORD = {{DB_PASS}}
HOSTPORT = {{DB_PORT}}
CHARSET = {{DB_CHARSET}}
DEBUG = false
prefix = {{DB_PREFIX}}

[CACHE]
; 默认 file；改用 redis 时需安装并启用 PHP redis 扩展，且填写下方连接
DRIVER = {{CACHE_DRIVER}}
REDIS_HOST = {{REDIS_HOST}}
REDIS_PORT = {{REDIS_PORT}}
REDIS_PASSWORD = {{REDIS_PASSWORD}}
REDIS_SELECT = {{REDIS_SELECT}}
REDIS_TIMEOUT = {{REDIS_TIMEOUT}}
REDIS_EXPIRE = {{REDIS_EXPIRE}}

[LANG]
default_lang = {{LANG_DEFAULT}}

[system]
stop = {{SYSTEM_STOP}}

[USER]
REG_EMAIL_REQUIRED = {{USER_REG_EMAIL_REQUIRED}}
CAN_MODIFY_BIND_ADDRESS = {{USER_CAN_MODIFY_BIND_ADDRESS}}
CHECK_USER_ADDRESS = {{USER_CHECK_USER_ADDRESS}}
PRODUCT_TYPE = {{USER_PRODUCT_TYPE}}
ADMIN_GOOGLE_AUTH = {{USER_ADMIN_GOOGLE_AUTH}}
WITHDRAWAL_DISABLE_MSG = {{USER_WITHDRAWAL_DISABLE_MSG}}

[FILESYSTEM]
DRIVER = {{FILESYSTEM_DRIVER}}

[LOG]
CHANNEL = {{LOG_CHANNEL}}
